* text=auto

# Unreal Engine C++ source files
*.h                 text eol=lf
*.hpp               text eol=lf
*.c                 text eol=lf
*.cpp               text eol=lf
*.ixx               text eol=lf
*.inl               text eol=lf

# Unreal build/config files
*.cs                text eol=lf
*.uproject          text eol=lf
*.uplugin           text eol=lf
*.ini               text eol=lf
*.config            text eol=lf
*.json              text eol=lf

# Visual Studio/MSBuild files
*.sln               text eol=lf
*.vcxproj           text eol=lf
*.vcxproj.filters   text eol=lf
*.props             text eol=lf
*.targets           text eol=lf

# Scripts
*.bat               text eol=crlf
*.cmd               text eol=crlf
*.ps1               text eol=crlf
*.sh                text eol=lf

# Unreal generated/binary assets
*.uasset            binary
*.umap              binary
*.ubulk             binary
*.uexp              binary
*.pak               binary

# Common binary assets
*.png               binary
*.jpg               binary
*.jpeg              binary
*.gif               binary
*.bmp               binary
*.ico               binary
*.wav               binary
*.mp3               binary
*.ogg               binary
